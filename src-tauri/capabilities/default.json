{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/**" }]
    },
    "os:default",
    "allow-fetch-update-manifest",
    "allow-download-update-asset",
    "allow-desktop-save-image",
    "allow-quit-app"
  ]
}
