{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gouer工具包包",
  "version": "1.9.0",
  "identifier": "com.gouer.watermark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gouer工具包包 —— 一站式图片处理工具",
        "width": 1100,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["../icon.icns", "../icon.ico"]
  }
}
