{
  "name": "shuiyinimg",
  "private": true,
  "version": "1.9.0",
  "type": "commonjs",
  "scripts": {
    "browser:dev": "vite --open",
    "build": "vite build",
    "electron:build": "vite build && electron-builder",
    "electron:macbuild": "vite build && electron-builder",
    "electron:winbuild": "npm run electron:build -- --win"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.5.0",
    "browser-image-compression": "^2.0.2",
    "compressorjs": "^1.2.1",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "pako": "^2.1.0",
    "rgbcolor": "^1.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.gouer.watermark",
    "productName": "Gouer工具包包",
    "copyright": "Copyright © 2024 Gouer.vip",
    "publish": [
      {
        "provider": "generic",
        "url": "https://up.gouer.vip/shuiyin/"
      }
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "electronUpdaterCompatibility": ">=2.15",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Please allow access to script browser applications to run the app.",
        "NSCameraUsageDescription": "Please allow access to camera to take photos.",
        "NSMicrophoneUsageDescription": "Please allow access to microphone to record audio.",
        "NSPhotoLibraryUsageDescription": "Please allow access to photo library to save photos."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 640,
        "height": 480
      },
      "iconSize": 128,
      "backgroundColor": "#ffffff",
      "title": "Gouer工具包包",
      "format": "UDZO",
      "internetEnabled": true,
      "sign": false,
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gouer工具包包"
    },
    "asar": true
  }
}
