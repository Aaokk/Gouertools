{
  "name": "shuiyinimg",
  "private": true,
  "_version_sync_note": "只需改 package.json 的 version。tauri:dev / tauri:build 会经 tauri.conf 钩子自动 sync 到 Cargo.toml 与 tauri.conf.json；也可用 npm version patch 会自动跑 version 脚本同步。一般不必手敲 sync-version（除非只跑 vite / 纯 cargo 且不经 tauri cli）。",
  "version": "3.0.8",
  "type": "commonjs",
  "scripts": {
    "sync-version": "node scripts/sync-version-from-package.mjs",
    "version": "node scripts/sync-version-from-package.mjs",
    "browser:dev": "vite --open --host",
    "build": "vite build",
    "build:seo": "vite build && node scripts/prerender.mjs",
    "tauri:before-dev": "npm run sync-version && vite --host 127.0.0.1 --port 5173 --strictPort",
    "tauri:before-build": "npm run sync-version && npm run build",
    "tauri": "tauri",
    "tauri:icon": "tauri icon ./public/favicon.svg",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run sync-version && node scripts/tauri-build.mjs"
  },
  "devDependencies": {
    "@ckpack/vue-color": "^1.5.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "puppeteer": "^25.0.2",
    "qrcode": "^1.5.4",
    "svgo": "^4.0.1",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
